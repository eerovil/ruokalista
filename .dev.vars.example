# Copy to .dev.vars (gitignored) for local development.
# Any long random string will do locally:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI must be exactly
# <origin>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Structures pasted recipe text. Without it, intake says so and refuses.
ANTHROPIC_API_KEY=""

# Private s-ostoslista-client Worker HTTP API. The bearer token and household
# gate stay server-side; product search and list writes are never browser calls.
S_OSTOSLISTA_API_URL=""
S_OSTOSLISTA_API_TOKEN=""
S_OSTOSLISTA_HOUSEHOLD_ID=""
