{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruokalista",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK reaches for node:path and friends in its credential
  // chain. Without this the Worker throws at runtime rather than at build.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The Worker is the origin for the production hostname, so Cloudflare owns
  // both its DNS record and certificate. Keep workers.dev during the first
  // cutover as a fallback; it is not the canonical production URL.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ruokalista.vilpponen.fi",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruokalista",
      "database_id": "f81fabeb-b38f-453d-8966-dfe52c721341",
      "migrations_dir": "migrations"
    }
  ]
}
