{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruokalista",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK reaches for node:path and friends in its credential
  // chain. Without this the Worker throws at runtime rather than at build.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Keep the runtime secret contract explicit. Wrangler validates these names
  // against the Worker before deploy, and local development only exposes listed
  // keys from .dev.vars/.env when this block is present.
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ANTHROPIC_API_KEY",
      "BACKUP_GITHUB_TOKEN"
    ]
  },

  // Temporary #64 Cron Trigger diagnostic. Keep this deployment untouched until
  // one authentic scheduled invocation is observed, then restore 17 2 * * *.
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruokalista",
      "database_id": "f81fabeb-b38f-453d-8966-dfe52c721341",
      "migrations_dir": "migrations"
    }
  ]
}
