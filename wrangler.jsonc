{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruokalista",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK reaches for node:path and friends in its credential
  // chain. Without this the Worker throws at runtime rather than at build.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Nightly backup. Cron Triggers use UTC; the scheduled timestamp is also the
  // idempotency key written into snapshot.json and its Git commit message.
  "triggers": { "crons": ["17 2 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruokalista",
      "database_id": "f81fabeb-b38f-453d-8966-dfe52c721341",
      "migrations_dir": "migrations"
    }
  ]
}