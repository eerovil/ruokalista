{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruokalista",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK reaches for node:path and friends in its credential
  // chain. Without this the Worker throws at runtime rather than at build.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Fail deployment if the production backup credential is missing instead of
  // discovering that only after a Cron Trigger has silently failed.
  "secrets": { "required": ["BACKUP_GITHUB_TOKEN"] },

  // Temporary #64 acceptance-run retry. Cron Triggers use UTC; after the real
  // production snapshot + restore drill, restore the normal 02:17 UTC cron.
  "triggers": { "crons": ["15 15 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruokalista",
      "database_id": "f81fabeb-b38f-453d-8966-dfe52c721341",
      "migrations_dir": "migrations"
    }
  ]
}
