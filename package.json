{
  "name": "ruokalista",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types --test dev/*.ts",
    "check:backup-schema": "node --experimental-strip-types scripts/check-backup-schema.ts",
    "check:restore-roundtrip": "node --experimental-strip-types scripts/check-restore-roundtrip.ts",
    "restore:backup": "node --experimental-strip-types scripts/restore-backup.ts",
    "migrate:local": "wrangler d1 migrations apply ruokalista --local",
    "seed:local": "wrangler d1 execute ruokalista --local --file dev/seed.sql",
    "migrate:remote": "wrangler d1 migrations apply ruokalista --remote",
    "deploy": "wrangler deploy",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  }
}
